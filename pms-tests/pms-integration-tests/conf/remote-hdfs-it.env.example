# Copy this file outside the repository, replace the placeholders, and source it explicitly.
# Every export is commented so merely opening or sourcing the template cannot target a cluster.

# export JAVA_HOME=/path/to/temurin-17/Contents/Home
# export HADOOP_CONF_DIR=/path/to/hadoop-3.4.3/etc/hadoop
# export PMS_IT_LOCAL_ROOT=/absolute/path/to/pms-it/runs
# export PMS_IT_HDFS_ROOT=hdfs://namenode/tmp/pms-it-user
# export PMS_IT_CLEANUP=on-success
# export PMS_IT_START_TIMEOUT=60s
# export PMS_IT_OPERATION_TIMEOUT=120s

# After exporting the values, run from the repository root:
# mvn -Premote-hdfs-it -pl pms-tests/pms-integration-tests -am verify \
#   -Dpms.it.pms.java.home="$JAVA_HOME" \
#   -Dpms.it.hadoop.conf.dir="$HADOOP_CONF_DIR" \
#   -Dpms.it.local.root="$PMS_IT_LOCAL_ROOT" \
#   -Dpms.it.hdfs.root="$PMS_IT_HDFS_ROOT" \
#   -Dpms.it.cleanup="${PMS_IT_CLEANUP:-on-success}" \
#   -Dpms.it.start.timeout="${PMS_IT_START_TIMEOUT:-60s}" \
#   -Dpms.it.operation.timeout="${PMS_IT_OPERATION_TIMEOUT:-120s}"
